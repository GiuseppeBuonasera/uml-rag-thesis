# Ambiente
.venv/
__pycache__/
*.pyc

# Chiavi/segreti
.env

# Dati e risultati (di solito troppo pesanti/sperimentali per Git)
corpus/raw/*
!corpus/raw/.gitkeep
!corpus/raw/models_original/
# test set De Bari (2026-10-02): versionato, tenuto fuori dal retrieval
!corpus/raw/debari_test/
corpus/processed/*
!corpus/processed/.gitkeep
!corpus/processed/apollon/
!corpus/processed/corpus.jsonl
!corpus/processed/testset_debari.jsonl
!corpus/processed/apollon_debari/
data/results/*
!data/results/.gitkeep
# run del retrieval (Passo 2, 2026-10-04): si versionano config, sommario e CSV piccoli di ogni run; il resto no
!data/results/retrieval/
data/results/retrieval/*/*
!data/results/retrieval/*/config.json
!data/results/retrieval/*/summary.md
!data/results/retrieval/*/*.csv
# run di generazione (pilota 2026-10-06 e Passo 3b): il seed NON e' rispettato da LM Studio (decisions.md voci 72 e 74),
# quindi le risposte grezze sono l'unica base per riprodurre l'analisi -> si versionano config.json, manifest.jsonl,
# validation.csv, summary.md e raw/; NON prompts/ (rigenerabili in modo deterministico), parsed/ (derivati da raw/),
# cache/ (duplicato di raw/). Esclusi le prove con MockClient (mock_*) e i dry run (dry_run/).
!data/results/generation/
data/results/generation/*/*
!data/results/generation/*/config.json
!data/results/generation/*/manifest.jsonl
!data/results/generation/*/validation.csv
!data/results/generation/*/summary.md
!data/results/generation/*/raw/
data/results/generation/mock_*
data/results/generation/dry_run

# Notebook checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/settings.json

# Tool binari scaricati localmente (non versionare)
.tools/
