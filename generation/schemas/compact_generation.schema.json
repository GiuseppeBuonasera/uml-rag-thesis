{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compact class diagram (generation)",
  "type": "object",
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "class",
              "abstract",
              "interface",
              "enum"
            ]
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "association",
                  "unidirectional",
                  "dependency"
                ]
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "sourceMultiplicity": {
                "type": "string"
              },
              "targetMultiplicity": {
                "type": "string"
              },
              "sourceRole": {
                "type": "string"
              },
              "targetRole": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "composition",
                  "aggregation"
                ]
              },
              "whole": {
                "type": "string"
              },
              "part": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "wholeMultiplicity": {
                "type": "string"
              },
              "partMultiplicity": {
                "type": "string"
              },
              "wholeRole": {
                "type": "string"
              },
              "partRole": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "whole",
              "part"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "inheritance",
                  "realization"
                ]
              },
              "child": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "child",
              "parent"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 39
    }
  },
  "required": [
    "classes",
    "relations"
  ],
  "additionalProperties": false
}
